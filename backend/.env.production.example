# 服务器配置
PORT=3000
# 当前环境：development | test | production
NODE_ENV=production

# JWT 密钥（生产环境请务必使用随机强密钥）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-production-jwt-secret-key-at-least-64-characters-long
JWT_EXPIRES_IN=7d

# 腾讯云 TokenHub LLM API 配置（生产环境）
# 方式一：共用同一个 API Key（推荐，后台 CMS→AI配置 里可精细化管理三条角色配置）
TENCENT_LLM_API_KEY=your-production-tencent-tokenhub-api-key

# 方式二：每个角色独立 API Key（优先级高于 TENCENT_LLM_API_KEY）
# TENCENT_MAIN_AGENT_API_KEY=
# TENCENT_PRECIPITATION_API_KEY=
# TENCENT_HELPER_API_KEY=

# 模型名（统一使用 hy3，通过 thinking_mode 参数区分三档能力）
TENCENT_LLM_MODEL=hy3
TENCENT_MAIN_AGENT_MODEL=hy3
TENCENT_PRECIPITATION_MODEL=hy3
TENCENT_HELPER_MODEL=hy3

# 腾讯云 TokenHub API 基础地址
TENCENT_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 微信小程序配置
WECHAT_APPID=your-production-wechat-appid
WECHAT_SECRET=your-production-wechat-secret

# 腾讯云 COS 配置（可选）
COS_SECRET_ID=your-production-cos-secret-id
COS_SECRET_KEY=your-production-cos-secret-key
COS_BUCKET=your-production-bucket-name
COS_REGION=ap-guangzhou
COS_DOMAIN=https://your-production-bucket.cos.ap-guangzhou.myqcloud.com

# 数据库配置
# 生产环境建议使用绝对路径
DB_PATH=/var/lib/fitapp/app_production.db

# 数据库自动备份保留天数
DB_BACKUP_KEEP_DAYS=30

# 安全配置
# 是否启用严格的API密钥验证
STRICT_API_KEY_VALIDATION=true
# 是否启用请求日志
ENABLE_REQUEST_LOGGING=true
# 是否启用SQL查询日志（仅用于调试）
ENABLE_SQL_LOGGING=false