{
  "name": "jianfeidazi-backend",
  "version": "1.0.0",
  "description": "减肥搭子 APP 后端服务",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:test": "NODE_ENV=test node src/app.js",
    "start:prod": "NODE_ENV=production node src/app.js",
    "dev": "nodemon src/app.js",
    "pm2:test": "pm2 start ecosystem.config.js --only fit-backend-test",
    "pm2:prod": "pm2 start ecosystem.config.js --only fit-backend-prod",
    "pm2:stop:test": "pm2 stop fit-backend-test",
    "pm2:stop:prod": "pm2 stop fit-backend-prod",
    "pm2:restart:test": "pm2 restart fit-backend-test",
    "pm2:restart:prod": "pm2 restart fit-backend-prod",
    "init-db": "node src/scripts/init-db.js",
    "smoke-test": "NODE_ENV=test node scripts/smoke-test.js",
    "import-foods": "node src/scripts/import-foods.js",
    "import-exercises": "node src/scripts/import-exercises.js",
    "backup:db": "node scripts/backup-db.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-config": "node scripts/check-config-security.js",
    "generate-key": "node scripts/generate-secure-key.js"
  },
  "keywords": [
    "diet",
    "ai",
    "agent",
    "uniapp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.28.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "vitest": "^3.2.7"
  }
}
