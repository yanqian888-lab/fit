# 服务器配置
PORT=3000
# 当前环境：development | test | production
NODE_ENV=development

# JWT 密钥（生产环境请务必使用随机强密钥）
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 腾讯云 TokenHub LLM API 配置（默认 Hy3 模型）
# API Key 在腾讯云 TokenHub 控制台获取（推荐：共用同一个 API Key，后台 CMS→AI配置 里可精细化管理三条角色配置）
TENCENT_LLM_API_KEY=your-tencent-tokenhub-api-key

# 如需要为不同角色分配不同 Key，可单独配置（优先级高于 TENCENT_LLM_API_KEY）
# TENCENT_MAIN_AGENT_API_KEY=
# TENCENT_PRECIPITATION_API_KEY=
# TENCENT_HELPER_API_KEY=

# 模型名（腾讯云 TokenHub Hy3 直接写 hy3；三个 Agent 共用同一模型名，通过 thinking_mode 区分能力）
TENCENT_LLM_MODEL=hy3
TENCENT_MAIN_AGENT_MODEL=hy3
TENCENT_PRECIPITATION_MODEL=hy3
TENCENT_HELPER_MODEL=hy3

# 腾讯云 TokenHub API 基础地址
TENCENT_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 微信小程序配置
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# 腾讯云 COS 配置（可选）
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-guangzhou
COS_DOMAIN=https://your-bucket.cos.ap-guangzhou.myqcloud.com

# 数据库配置
# 开发环境
DB_PATH=./data/app.db
# 测试环境建议：DB_PATH=./data/app_test.db
# 正式环境建议：DB_PATH=./data/app_production.db

# 数据库自动备份保留天数
DB_BACKUP_KEEP_DAYS=7
