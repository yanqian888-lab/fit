# 测试环境配置
# 复制为 .env.test 后按需填写真实值，不要提交到 Git。
# 豆包 / 微信小程序 / COS 等密钥建议在根目录 .env 中统一维护；
# 本文件只覆盖测试环境专属的非敏感配置，避免部署时覆盖真实密钥。
NODE_ENV=test
PORT=3000

# JWT 密钥（请使用 openssl rand -hex 32 生成）
JWT_SECRET=your-test-jwt-secret
JWT_EXPIRES_IN=7d

# 腾讯云 TokenHub LLM API 配置（测试环境）
# 如需使用不同于 .env 的测试环境配置，取消注释并填写真实值
# TENCENT_LLM_API_KEY=
# TENCENT_MAIN_AGENT_API_KEY=
# TENCENT_PRECIPITATION_API_KEY=
# TENCENT_HELPER_API_KEY=
# TENCENT_LLM_MODEL=hy3
# TENCENT_MAIN_AGENT_MODEL=hy3
# TENCENT_PRECIPITATION_MODEL=hy3
# TENCENT_HELPER_MODEL=hy3
# TENCENT_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 微信小程序配置（测试环境可用测试号）
# WECHAT_APPID=
# WECHAT_SECRET=

# 腾讯云 COS 配置（可选）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-guangzhou
# COS_DOMAIN=

# 测试环境数据库（与生产环境隔离）
DB_PATH=./data/app_test.db

# 数据库自动备份保留天数
DB_BACKUP_KEEP_DAYS=7
