/* custom-tab-bar/index.wxss —— 完美复刻图1视觉 */

.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50px;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #FFFFFF;
  display: flex;
  flex-direction: row;
  z-index: 999;
  border-top: 1px solid #f0f0f0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.icon-wrap {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2px;
}

.icon-wrap.icon-active {
  background-color: #563E22;
}

.icon {
  width: 24px;
  height: 24px;
}

.text {
  font-size: 10px;
  color: #9CA3AF;
  line-height: 1;
}

.text.text-active {
  color: #563E22;
}
