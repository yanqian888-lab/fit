# Dependencies
backend/node_modules/
frontend/node_modules/
frontend/dist/
frontend/unpackage/

# Environment variables
# 后端真实环境配置（含密钥），不提交
backend/.env
backend/.env.test
backend/.env.production
# 前端/管理后台 .env.test / .env.production 只含公开域名，默认提交
# 如需本地覆盖，请使用 .env.test.local / .env.production.local
*.env.local
*.env.*.local

# Database
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Android signing certs - never push real certs
android-certs/*.keystore
android-certs/*.jks

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.AppleDouble
.LSOverride

# HBuilderX
.hbuilderx/

# UniApp
unpackage/

# Python venv
.venv/
venv/
__pycache__/

# Misc
*.tmp
*.temp
server-keys/
.preview/
# Uploaded user-generated files (keep .gitkeep only)
backend/public/avatars/*
!backend/public/avatars/.gitkeep
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Deploy SSH key
.fit_deploy.pem

# Local dev database at project root
data/
